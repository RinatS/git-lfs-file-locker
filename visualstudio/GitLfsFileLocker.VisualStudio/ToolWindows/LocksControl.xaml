<UserControl x:Class="GitLfsFileLocker.VisualStudio.LocksControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Loading..." />
            <Button Content="Refresh"
                    Margin="8,0,0,0"
                    Padding="8,3"
                    Click="OnRefreshClicked"
                    AutomationProperties.Name="Refresh locks" />
        </DockPanel>

        <DataGrid Grid.Row="1"
                  x:Name="LocksGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="90" />
                <DataGridTextColumn Header="Path" Binding="{Binding path}" Width="*" />
                <DataGridTextColumn Header="Owner" Binding="{Binding owner.name}" Width="130" />
                <DataGridTextColumn Header="Locked At" Binding="{Binding locked_at}" Width="170" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Unlock Selected"
                    Padding="8,3"
                    Click="OnUnlockClicked"
                    AutomationProperties.Name="Unlock selected lock" />
        </StackPanel>
    </Grid>
</UserControl>
